FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-test.txt /tmp/requirements.txt
COPY backend/requirements-checkpoint.lock /tmp/checkpoint.lock
ENV PIP_CONSTRAINT=/tmp/checkpoint.lock
RUN pip install --no-cache-dir -r /tmp/requirements.txt opencv-python-headless==4.11.0.86 && pip install --no-cache-dir torch==2.6.0+cpu torchvision==0.21.0+cpu --index-url https://download.pytorch.org/whl/cpu
COPY backend/app /app/app
ENV PYTHONDONTWRITEBYTECODE=1 GCAI_MODEL_PATH=/assets/160_model.pth
USER 10001:10001
COPY tools/verify_checkpoint.py /app/verify_checkpoint.py
ENTRYPOINT ["python", "/app/verify_checkpoint.py"]
